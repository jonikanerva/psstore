# Prettier 3 already honors the root .gitignore (node_modules, coverage,
# build, dist, .cache, .vite, .pnpm-store, .sony-contract), so only list
# tracked files that are NOT in .gitignore but must not be reformatted.
pnpm-lock.yaml

# Generated by `pnpm sony:diff` (runs inside test-all); it is rewritten
# in its own format every run, so formatting it just causes drift.
docs/contracts/reports/latest-diff.md

