# openapi`). The contract check compares it byte for byte, so it keeps the
# formatting of the export.
contract/openapi.json

# Generated by `pnpm --filter @psstore/api-client run generate`. The
# contract check compares the generator output byte for byte.
packages/api-client/src/generated/
