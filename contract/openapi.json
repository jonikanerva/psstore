{
  "openapi": "3.1.0",
  "info": {
    "title": "psstore API",
    "description": "The Finnish PS5 store view of psstore. Every failure answers RFC 9457 Problem Details (`application/problem+json`) with a stable `code`.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/games/browse": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "BROWSE: the PS5 games of one Sony genre in one order.",
        "operationId": "browseGames",
        "parameters": [
          {
            "name": "genre",
            "in": "query",
            "description": "A Sony genre key from `GET /api/games/genres`. The server does not\ntrim it.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9_/-]{1,64}$"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BrowseOrder"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The index of the first game. The default is 0.",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The number of games on the page: 1 to 120. The default is 60.",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 120,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the genre in the order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResult"
                }
              }
            }
          },
          "400": {
            "description": "Problem `invalid_request`: an invalid query parameter, path segment, or body.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Problem `internal_error`: the server failed to handle the request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Problem `upstream_unavailable` or `upstream_query_rotated`: Sony failed, timed out, answered unexpectedly, or no longer knows a persisted query.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Problem `upstream_rate_limited`: Sony limited the request rate. `retryAfterSeconds` gives Sony's delay when Sony sent one.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
