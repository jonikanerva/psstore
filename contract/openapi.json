    "/api/games/{id}": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "The game page: the game and its critic score. The score lookup never\nfails; without a trusted score the key is absent.",
        "operationId": "getGame",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "A game id from a card. The server trims it; the trimmed id is not\nempty.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
